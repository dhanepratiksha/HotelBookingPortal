#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Start Up Batch script
# ----------------------------------------------------------------------------

WRAPPER_JAR="$(dirname "$0")/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$(dirname "$0")/.mvn/wrapper/maven-wrapper.properties"

if [ ! -e "$WRAPPER_JAR" ]; then
    WRAPPER_URL=$(grep -e "^wrapperUrl=" "$WRAPPER_PROPERTIES" | cut -d'=' -f2)
    which curl >/dev/null 2>&1 && curl -o "$WRAPPER_JAR" "$WRAPPER_URL" || which wget >/dev/null 2>&1 && wget -O "$WRAPPER_JAR" "$WRAPPER_URL"
fi

if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

exec "$JAVACMD" "-Dmaven.multiModuleProjectDirectory=$(dirname "$0")" -classpath "$WRAPPER_JAR" org.apache.maven.wrapper.MavenWrapperMain "$@"
